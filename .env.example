# Путь к Chrome (для сервера Ubuntu: /usr/bin/google-chrome или /usr/bin/chromium). Для Windows оставьте пустым.
#EXECUTABLE_PATH=/usr/bin/chromium

# true — работать в фоне (обязательно для сервера)
HEADLESS=true

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Список HTTP/HTTPS прокси для работы из РФ (формат host:port:user:pass или host:port)
# PROXY_LIST=123.45.67.89:8080:username:password,98.76.54.32:3128
PROXY_LIST=

PORT=3001

# Лимит автоматического планового сбора игр в сутки для крона (защита токенов и диска). Ручной запуск работает без лимита.
MAX_DAILY_CRAWL_GAMES=60
